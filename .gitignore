# Runtime state lives here when DEV_TRIANGLE_HOME is unset, so the folder stays
# ignored. verify.json is the exception: it is this repo's own declaration of
# which commands may be run against it, and it only means anything if it is
# committed and reviewable.
.dev-triangle/*
!.dev-triangle/verify.json
.dev-triangle-test/
.dev-triangle-report-test/
.codegraph/
demo-output/
logs/
docs/LOCAL_PRODUCTIZATION_REPORT.md
# Generated by profile_activate. This is machine-local runtime state, not a
# reviewed provider profile.
config/active-profile.json
# Project-scoped MCP config for Claude Code. Generated by install-local.ps1 and
# full of this machine's absolute paths, so it stays out of git. The committed
# reference for its shape is config/README.md.
.mcp.json
__pycache__/
*.pyc
*.log
*.tmp
.env
